# Without a key or without a model, the narrator runs in offline mode (templates, zero cost).
OPENROUTER_API_KEY=
# Pick a model at https://openrouter.ai/models (better one that does NOT reason: it is slower and pricier to narrate).
NARRATOR_MODEL=
# Set to 1 to ask for reasoning and stream it live. Off by default: it triples latency and cost.
NARRATOR_REASONING=0
NARRATION_LANGUAGE=English
# Cumulative spend cap (USD) at which the narrator switches to offline mode.
SPEND_CAP_USD=0.5
SEED=1337
PORT=3000
DB_PATH=game.db
