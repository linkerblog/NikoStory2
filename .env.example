# Without a key or without a model, every role runs offline (interpreter, narrator, memories):
# deterministic, template-based, zero cost. Set the key and a model to use the LLM.
OPENROUTER_API_KEY=

# The Models tab in the app can override any model or reasoning flag below without a restart; its
# choices are saved in the database and win over this file. The API key is only ever read from here.
# One model per role. Each <ROLE>_MODEL defaults to NARRATOR_MODEL, so setting only NARRATOR_MODEL
# uses one model everywhere. The roles are: INTERPRETER, NARRATOR, ARCHITECT, CONTINUITY, MEMORY, NPC, CAST, GOVERNMENT.
NARRATOR_MODEL=
# INTERPRETER_MODEL=
# ARCHITECT_MODEL=
# CONTINUITY_MODEL=
# MEMORY_MODEL=
# CAST_MODEL=      # writes the personality and voice of each new game's characters
# GOVERNMENT_MODEL=  # writes the city, institutions and incident protocol of each new game

# Reasoning per role. Defaults: on for INTERPRETER, ARCHITECT, CONTINUITY and GOVERNMENT; off for NARRATOR, MEMORY
# and CAST (reasoning triples latency and cost for no benefit in the prose).
# <ROLE>_REASONING accepts 1 or 0 and replaces the old NARRATOR_REASONING.
# CONTINUITY_REASONING=1
# NARRATOR_REASONING=0

# Idle timeout per role in milliseconds: how long a call may go without a new chunk before it is
# aborted (it resets on every chunk, so a long reasoning call is not cut off). Defaults: 120000 for
# roles with reasoning on, 60000 otherwise.
# INTERPRETER_IDLE_MS=120000

NARRATION_LANGUAGE=English
# Cumulative spend cap (USD) at which every role switches to offline; the turns are flagged degraded.
SPEND_CAP_USD=0.5
SEED=1337
PORT=3000
DB_PATH=game.db
